# Copy to .env and fill in. Never commit .env.

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set to "true" to expose /styleguide in production builds (off by default).
ENABLE_STYLEGUIDE="false"

# --- Database (PostgreSQL) ---
# Local: `npm run local` fills these in for you (Prisma's built-in Postgres).
# Live (Supabase, Mumbai): Project → Connect → copy the two "pooler" addresses.
#   DATABASE_URL = Transaction pooler (port 6543), used by the site:
#     postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require
#   DIRECT_URL   = Session pooler (port 5432), used for table updates on each deploy:
#     postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/gudiya"
DIRECT_URL="postgresql://<user>:<password>@localhost:5432/gudiya"
# Connections per server instance. Default: 10, or 2 on Netlify.
DATABASE_POOL_MAX=""

# --- File uploads (book covers, blog images, PDFs, videos) ---
# "local": saved on this computer's disk and served at /uploads/... (default, local only)
# "s3":    saved to Cloudflare R2 (or Amazon S3). Required on Netlify. Steps: docs/STORAGE.md
STORAGE_DRIVER="local"
# Local only. Default is ./storage/uploads.
UPLOAD_DIR=""
# S3 / R2 only.
S3_BUCKET=""
# Cloudflare R2: "auto". Amazon S3: the bucket's region, e.g. ap-south-1.
S3_REGION="auto"
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com   (empty for Amazon S3)
S3_ENDPOINT=""
# Public address for files: the bucket's r2.dev address or your custom domain, e.g. https://media.gudiyastories.com
S3_PUBLIC_URL=""
# R2: Manage API tokens → Create token (Object Read & Write, this bucket only).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Auth.js (NextAuth v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# First admin user, created by the seed script (role OWNER).
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_NAME="S.V. Bharathi"
# Development only: adds 50 copies of each book as clearly labelled demo stock.
# Leave "false" for production. Real opening counts are listed in docs/CONTENT-TODO.md.
SEED_DEMO_STOCK="false"

# --- Payments: Razorpay (real payments only; there is no pretend gateway) ---
# Easiest: leave these empty and paste your keys in Admin → Settings → Online
# payments. They are checked with Razorpay and stored encrypted. The moment
# valid keys are saved, checkout takes real payments. Without keys, checkout
# offers cash on delivery and WhatsApp only.
# Keys set here take priority over Admin. Never put real keys in this file.
# The live site (NODE_ENV=production) only accepts live keys (rzp_live_...).
# Full steps: docs/PAYMENTS.md
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional. Payments are confirmed by asking Razorpay directly, so no webhook is
# needed. If you add one later, this is the secret YOU type when creating it.
RAZORPAY_WEBHOOK_SECRET=""
# On your own computer the server checks open payments with Razorpay every 2 minutes.
# On Netlify this is done by netlify/functions/payments-sweep.mjs every 5 minutes instead.
PAYMENT_SWEEP="on"

# --- Resend (transactional email) ---
RESEND_API_KEY=""
EMAIL_FROM="Gudiya Stories <orders@gudiyastories.com>"
# Owner notifications: new orders, bulk enquiries, low-stock digest.
OWNER_NOTIFICATION_EMAIL="owner@example.com"

# --- WhatsApp order confirmations (optional, Meta WhatsApp Cloud API) ---
# Template needs 3 body variables: {{1}} name, {{2}} order number, {{3}} total.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ORDER_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"

# --- Analytics ---
# Secret used to derive the daily salt for cookie-free session hashes.
ANALYTICS_SALT_SECRET=""

# --- Scheduled jobs (/api/cron/daily, /api/cron/payments; send "Authorization: Bearer CRON_SECRET") ---
CRON_SECRET=""

# --- PIN code lookup ---
PINCODE_API_URL="https://api.postalpincode.in/pincode"
