# Live settings on the server: /srv/gudiya/shared/.env
# Readable only by the site. Every release links to this file.
# setup-server.sh fills in the domain, database and secrets.
# After changing anything here: sudo systemctl restart gudiya

# --- Site address (https, no trailing slash) ---
NEXT_PUBLIC_SITE_URL="https://__DOMAIN__"
AUTH_URL="https://__DOMAIN__"
AUTH_TRUST_HOST="true"
ENABLE_STYLEGUIDE="false"

# --- Database: PostgreSQL on this server (localhost only) ---
DATABASE_URL="postgresql://gudiya:__DBPASS__@127.0.0.1:5432/gudiya"
DIRECT_URL="postgresql://gudiya:__DBPASS__@127.0.0.1:5432/gudiya"
DATABASE_POOL_MAX="10"

# --- Secrets (generated; keep them) ---
# AUTH_SECRET also encrypts the Razorpay keys saved in Admin. Changing it signs
# everyone out and the Razorpay keys must be entered again.
AUTH_SECRET="__AUTH_SECRET__"
CRON_SECRET="__CRON_SECRET__"
ANALYTICS_SALT_SECRET="__ANALYTICS_SALT_SECRET__"

# --- First owner login: used once, on the very first deploy ---
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="S.V. Bharathi"
SEED_DEMO_STOCK="false"

# --- Uploads (covers, blog pictures, PDFs, videos): this server's disk ---
STORAGE_DRIVER="local"
UPLOAD_DIR="/srv/gudiya/shared/uploads"

# --- Payments: paste LIVE keys in Admin → Settings → Online payments ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_SWEEP="on"

# --- Order emails (required): customer confirmation + "new order" to you ---
RESEND_API_KEY=""
EMAIL_FROM="Gudiya Stories <orders@__DOMAIN__>"
OWNER_NOTIFICATION_EMAIL=""
# Where customer replies go (default: the shop email in src/config/site.ts).
EMAIL_REPLY_TO=""

# --- WhatsApp order messages (optional) ---
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ORDER_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"

PINCODE_API_URL="https://api.postalpincode.in/pincode"
