enum SalesChannel {
  WEBSITE
  WHATSAPP
  AMAZON
  FLIPKART
  BULK
  OFFLINE
  PHONE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
  EXPIRED
}

enum PaymentMethod {
  RAZORPAY
  COD
  PAYMENT_LINK
  MANUAL
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

model Customer {
  id                 String    @id @default(cuid())
  name               String
  phone              String    @unique // E.164, +91...
  email              String?   @unique
  emailVerified      DateTime? @db.Timestamptz(3) // used by Auth.js magic link
  // Marketing consent is tracked separately from transactional email.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  redemptions        CouponRedemption[]
  subscriber         Subscriber?
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  pinCode    String
  country    String   @default("IN")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([customerId])
}

model Order {
  id             String        @id @default(cuid())
  number         String        @unique // e.g. GS-260001
  status         OrderStatus   @default(PENDING_PAYMENT)
  channel        SalesChannel  @default(WEBSITE)
  paymentMethod  PaymentMethod

  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Contact and address are snapshotted at purchase time.
  contactName    String
  contactPhone   String
  contactEmail   String?
  shipName       String
  shipPhone      String
  shipLine1      String
  shipLine2      String?
  shipLandmark   String?
  shipCity       String
  shipState      String
  shipPinCode    String
  shipCountry    String        @default("IN")

  subtotalPaise  Int
  discountPaise  Int           @default(0)
  shippingPaise  Int           @default(0)
  codFeePaise    Int           @default(0)
  totalPaise     Int

  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode     String?

  customerNote   String?
  internalNotes  String?

  // Attribution (first-party analytics session hash and UTMs)
  sessionId      String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?

  reviewTokenHash String?      @unique
  expiresAt      DateTime?     @db.Timestamptz(3) // pending orders expire after 30 minutes
  paidAt         DateTime?     @db.Timestamptz(3)
  packedAt       DateTime?     @db.Timestamptz(3)
  shippedAt      DateTime?     @db.Timestamptz(3)
  deliveredAt    DateTime?     @db.Timestamptz(3)
  cancelledAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  createdById    String?
  createdBy      AdminUser?    @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items          OrderItem[]
  payments       Payment[]
  shipments      Shipment[]
  refunds        Refund[]
  events         OrderEvent[]
  stockMovements StockMovement[]
  redemption     CouponRedemption?
  enquiry        Enquiry?

  @@index([status, createdAt])
  @@index([contactPhone])
  @@index([channel, createdAt])
}

// Snapshot of title/price/SKU at purchase.
model OrderItem {
  id             String      @id @default(cuid())
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku            String
  title          String
  productType    ProductType
  unitPricePaise Int
  unitMrpPaise   Int
  quantity       Int
  lineTotalPaise Int
  // For bundles: [{ sku, title, quantity }] at purchase time
  bundleSnapshot Json?
  review         Review?

  @@index([orderId])
  @@index([productId])
}

// Status timeline for an order.
model OrderEvent {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus?
  message     String
  adminUserId String?
  adminUser   AdminUser?   @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus @default(CREATED)
  amountPaise       Int
  currency          String        @default("INR")
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  razorpayPaymentLinkId String?   @unique
  instrument        String?       // upi, card, netbanking, wallet
  raw               Json?
  capturedAt        DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  refunds           Refund[]
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier        String
  trackingNumber String
  trackingUrl    String?
  shippedAt      DateTime  @default(now()) @db.Timestamptz(3)
  deliveredAt    DateTime? @db.Timestamptz(3)

  @@index([orderId])
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId        String?
  payment          Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  razorpayRefundId String?      @unique
  amountPaise      Int
  reason           String?
  restocked        Boolean      @default(false)
  status           RefundStatus @default(PENDING)
  adminUserId      String?
  adminUser        AdminUser?   @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id                    String     @id @default(cuid())
  code                  String     @unique
  description           String?
  type                  CouponType
  // PERCENTAGE: whole percent (10 = 10%). FIXED: paise.
  amount                Int
  minOrderPaise         Int?
  startsAt              DateTime?  @db.Timestamptz(3)
  endsAt                DateTime?  @db.Timestamptz(3)
  usageLimitTotal       Int?
  usageLimitPerCustomer Int?
  firstOrderOnly        Boolean    @default(false)
  active                Boolean    @default(true)
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @db.Timestamptz(3)

  restrictedProductIds  String[]   @default([])
  restrictedValues      Value[]    @relation("CouponValues")
  orders                Order[]
  redemptions           CouponRedemption[]
}

model CouponRedemption {
  id            String    @id @default(cuid())
  couponId      String
  coupon        Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountPaise Int
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([couponId, customerId])
}

// Webhook idempotency: every processed Razorpay event ID is stored here.
model WebhookEvent {
  id          String   @id // provider event id
  provider    String   @default("razorpay")
  type        String
  processedAt DateTime @default(now()) @db.Timestamptz(3)
}

// Cache for Indian PIN code lookups (city/state autofill).
model PinCode {
  pinCode   String   @id
  city      String
  district  String?
  state     String
  fetchedAt DateTime @default(now()) @db.Timestamptz(3)
}
